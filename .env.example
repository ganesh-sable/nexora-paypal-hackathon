# Nexora E-Commerce Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual configuration.
# Do NOT commit your actual .env file to GitHub.

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASS=your_secure_password_here

# AI Chatbot Configuration (OpenRouter - Default Provider)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=auto

# PayPal REST API Configuration (https://developer.paypal.com/dashboard/)
# Get your credentials from PayPal Developer Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# Optional Legacy / Direct Google Gemini API
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-1.5-flash
