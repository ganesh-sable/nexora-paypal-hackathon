# ==============================================================================
# Nexora AI E-Commerce Platform - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your credentials below.
# 3. NEVER commit your actual .env file to Git or version control!
# ==============================================================================

# Application Environment ('development' or 'production')
APP_ENV=development
APP_URL=http://localhost:8000
PORT=10000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Neon Cloud PostgreSQL Connection String (Recommended for Cloud / Render)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual PostgreSQL parameters (Used for local Docker or standard setups)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASS=your_postgres_password
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# AI Shopping Assistant (OpenRouter API)
# ------------------------------------------------------------------------------
# Obtain your API key at: https://openrouter.ai/keys
# 'auto' intelligently routes requests to the optimal free/cost-effective model
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=auto

# ------------------------------------------------------------------------------
# PayPal REST API Integration
# ------------------------------------------------------------------------------
# Obtain Sandbox credentials at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox

# ------------------------------------------------------------------------------
# Optional: Alternative Gemini API Key (Fallback)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
